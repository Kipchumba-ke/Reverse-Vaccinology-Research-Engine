# Copy to .env and fill in. Never commit the real .env file.

# Required
# In production use your own database password, and a random secret of at
# least 32 characters, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing JWT_SECRET_KEY signs everyone out.
DATABASE_URL=postgresql+psycopg://vaccinology:vaccinology_dev@localhost:5432/reverse_vaccinology
JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional: login token lifetime in minutes (default 1440 = 24 hours)
# JWT_EXPIRES_MINUTES=1440

# Optional: comma-separated browser origins allowed to call the API
# (default http://localhost:5173)
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Background jobs (default redis://localhost:6379/0)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# BLAST+ executables, if not on PATH
# BLASTP_EXECUTABLE=/usr/bin/blastp
# MAKEBLASTDB_EXECUTABLE=/usr/bin/makeblastdb

# Host BLAST database prefixes (defaults to data/reference/<host>/<host>_proteome_db)
# HOST_BLAST_DATABASE_HUMAN=
# HOST_BLAST_DATABASE_MOUSE=
# HOST_BLAST_DATABASE_PIG=

# Optional local ePath essentiality database
# ESSENTIALITY_EPATH_DB_PATH=

# Test suite only
# TEST_DATABASE_URL=

# Rate limiting (see app/services/rate_limit.py)
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1   # share counters between workers
# RATE_LIMIT_AUTH=10/minute          # login and registration, per IP
# RATE_LIMIT_ANALYSIS=30/hour        # analysis submissions, per user
# RATE_LIMIT_DEFAULT=300/minute      # every request, per IP
# TRUSTED_PROXY_COUNT=1              # reverse proxies in front of the API

# Input limits (see app/utils/limits.py)
# MAX_SEQUENCE_LENGTH=5000
# MAX_FASTA_RECORDS=50
# MAX_ALIGNMENT_CELLS=4000000
# MAX_REQUEST_BYTES=2000000

# Alignment used for conservation when Clustal Omega is unavailable
# (identity or blosum62; default blosum62)
# ALIGNMENT_SCORING=blosum62

# Host-similarity interpretation thresholds (provisional, uncited defaults)
# HOST_SIMILARITY_BROAD_IDENTITY=70
# HOST_SIMILARITY_COVERAGE=80
# HOST_SIMILARITY_MODERATE_IDENTITY=30

# Short-peptide scan of 15-residue windows against the host database (off by default)
# HOST_PEPTIDE_SCAN=1
# HOST_PEPTIDE_MIN_MATCH=8
# HOST_PEPTIDE_MAX_QUERIES=25

# ---------------------------------------------------------------------------
# Optional predictors. All are off by default and fail soft: if one is
# switched on but not set up, the report says so under "Prediction Tools".
# ---------------------------------------------------------------------------

# DeepTMHMM and SignalP-on-BioLib run in DTU's BioLib cloud and send your
# sequence there. Needs: pip install pybiolib, and on a server a BioLib API
# token (BioLib account settings), or run `biolib login` once on a workstation.
# BIOLIB_TOKEN=

# DeepTMHMM (through BioLib)
# DEEPTMHMM_ENABLED=1

# SignalP 6.0. DTU licenses the local download to academic users, so by
# default this needs your own install. Leave it off if you do not have one.
# SIGNALP_ENABLED=1
# SIGNALP_BACKEND=local              # local (your signalp6 install) or biolib (BioLib cloud)
# SIGNALP6_EXECUTABLE=               # path to signalp6 when SIGNALP_BACKEND=local and it is not on PATH
# SIGNALP_BIOLIB_APP=DTU/SignalP_6   # only used when SIGNALP_BACKEND=biolib
# SIGNALP_ORGANISM=other             # other (bacteria) or eukarya

# PSORTb 3.0 (open source; bacteria and archaea only). Runs on your own
# machine, no data leaves it. Easiest is the Docker image:
#   docker pull brinkmanlab/psortb_commandline:1.0.2
# PSORTB_ENABLED=1
# PSORTB_BACKEND=docker              # docker or local
# PSORTB_DOCKER_IMAGE=brinkmanlab/psortb_commandline:1.0.2
# DOCKER_EXECUTABLE=docker
# PSORTB_EXECUTABLE=                 # path to psort when PSORTB_BACKEND=local and it is not on PATH
# PSORTB_GRAM=negative               # negative, positive or archaea

# IEDB Analysis Resource (sends the sequence to IEDB; no account needed)
# IEDB_ENABLED=1
# IEDB_MHCI_ALLELES=HLA-A*01:01,HLA-A*02:01
# IEDB_MHCII_ALLELES=HLA-DRB1*01:01,HLA-DRB1*04:01
# IEDB_MHCI_LENGTH=9
# IEDB_MHCII_LENGTH=15
# IEDB_MHCI_RANK_CUTOFF=1            # percentile rank; lower is a stronger predicted binder
# IEDB_MHCII_RANK_CUTOFF=10
# IEDB_MAX_SEQUENCE_LENGTH=1500
# IEDB_TIMEOUT_SECONDS=120

# Do not put spaces after a value or a quote around it: write KEY=value.
