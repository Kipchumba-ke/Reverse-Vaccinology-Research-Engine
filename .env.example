# Copy to .env and fill in. Never commit the real .env file.

# Required
DATABASE_URL=postgresql+psycopg://vaccinology:vaccinology_dev@localhost:5432/reverse_vaccinology
JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional: login token lifetime in minutes (default 1440 = 24 hours)
# JWT_EXPIRES_MINUTES=1440

# Optional: comma-separated browser origins allowed to call the API
# (default http://localhost:5173)
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Background jobs (default redis://localhost:6379/0)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# BLAST+ executables, if not on PATH
# BLASTP_EXECUTABLE=/usr/bin/blastp
# MAKEBLASTDB_EXECUTABLE=/usr/bin/makeblastdb

# Host BLAST database prefixes (defaults to data/reference/<host>/<host>_proteome_db)
# HOST_BLAST_DATABASE_HUMAN=
# HOST_BLAST_DATABASE_MOUSE=
# HOST_BLAST_DATABASE_PIG=

# Optional local ePath essentiality database
# ESSENTIALITY_EPATH_DB_PATH=

# Test suite only
# TEST_DATABASE_URL=
